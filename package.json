{
  "name": "steward",
  "version": "0.1.0",
  "private": true,
  "description": "Project Steward \u2014 the personal agent operating layer",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --import tsx --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "demo": "tsx apps/console/src/demo.ts",
    "console": "tsx apps/console/src/server.ts",
    "eval": "tsx packages/evals/src/run.ts",
    "demo:flow": "tsx scripts/demo-flow.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}